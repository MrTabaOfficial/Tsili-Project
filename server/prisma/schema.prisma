generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  members       Member[]
}

/// One row per issued refresh token. Only the SHA-256 hash is stored, so a
/// database leak does not hand out working sessions.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  /// All tokens rotated from the same login share a family; reuse of a revoked token revokes the whole family.
  familyId  String    @db.Uuid
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Group {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  currency   String
  inviteCode String    @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  members    Member[]
  expenses   Expense[]
  repayments Repayment[]
}

/// A person in a group. userId stays null until an account joins by invite and claims the slot.
model Member {
  id        String    @id @default(uuid()) @db.Uuid
  groupId   String    @db.Uuid
  name      String
  userId    String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// Assigned from the global sync_seq sequence on every write; the sync cursor is the highest value a client has seen.
  serverSeq BigInt    @default(dbgenerated("nextval('sync_seq'::regclass)"))

  group          Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  expensesPaid   Expense[]
  repaymentsFrom Repayment[] @relation("RepaymentFrom")
  repaymentsTo   Repayment[] @relation("RepaymentTo")

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId, serverSeq])
}

/// Client-owned record: id and timestamps come from the phone that created it; the server only validates and orders.
model Expense {
  id            String    @id @db.Uuid
  groupId       String    @db.Uuid
  payerMemberId String    @db.Uuid
  amount        BigInt
  description   String
  date          String    @db.VarChar(10)
  splitRule     Json
  shares        Json
  createdAt     DateTime
  updatedAt     DateTime
  deletedAt     DateTime?
  serverSeq     BigInt    @default(dbgenerated("nextval('sync_seq'::regclass)"))

  group Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer Member @relation(fields: [payerMemberId], references: [id])

  @@index([groupId, serverSeq])
}

model Repayment {
  id           String    @id @db.Uuid
  groupId      String    @db.Uuid
  fromMemberId String    @db.Uuid
  toMemberId   String    @db.Uuid
  amount       BigInt
  date         String    @db.VarChar(10)
  note         String?
  createdAt    DateTime
  updatedAt    DateTime
  deletedAt    DateTime?
  serverSeq    BigInt    @default(dbgenerated("nextval('sync_seq'::regclass)"))

  group Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  from  Member @relation("RepaymentFrom", fields: [fromMemberId], references: [id])
  to    Member @relation("RepaymentTo", fields: [toMemberId], references: [id])

  @@index([groupId, serverSeq])
}
