# Copy to .env for local development. Never commit .env.

# Matches docker-compose.yml. Tests use the tsili_test database on the same server.
DATABASE_URL=postgresql://tsili:tsili@localhost:5432/tsili

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Login and register attempts allowed per client address per 15 minutes.
AUTH_RATE_LIMIT_MAX=20
