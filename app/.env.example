# Copy to .env. Expo inlines EXPO_PUBLIC_* variables into the app bundle at build time.
# Use your computer's LAN address so a phone on the same Wi-Fi can reach the server.
# Android emulator: http://10.0.2.2:4000   iOS simulator / web: http://localhost:4000
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
